{
  "name": "Mega Links Checker",
  "description": "Telegram bot for checking Mega links.",
  "repository": "https://github.com/ImKrishana/Mega-Links-Checker",
  "logo": "",
  "keywords": [
    "telegram",
    "bot",
    "mega",
    "python"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "OWNER_ID": {
      "description": "Bot owner Telegram user ID",
      "required": true
    },
    "DATABASE_URL": {
      "description": "MongoDB connection URL",
      "required": true
    },
    "LOG_CHANNEL": {
      "description": "Log channel IDs",
      "required": false,
      "value": "[]"
    },
    "PORT": {
      "description": "Web server port",
      "required": false,
      "value": "8080"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "standard-1x"
    }
  }
}
